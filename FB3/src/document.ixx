// Document — книга FB3, открытая на чтение: метаданные, дерево тела,
// картинки и сноски.
//
// Document владеет всем, на что смотрит модель: пакетом, буферами разобранных
// частей и ареной узлов. Тексты узлов — виды в эти буферы, поэтому книга
// не копируется ни разу от файла до вёрстки, а правило владения ровно одно:
// узлы живут столько же, сколько Document.
//
// Поэтому же Document неперемещаем: виды указывают внутрь его буферов.
// Открывают книгу конструктором и держат там, где она нужна (обычно в модели
// приложения), а передают по ссылке.
//
// Требование к среде: wxl.xml выделяет память из STA-пула wxl.core, который
// должен существовать до первого разбора и пережить последнюю книгу.
// Создаётся один раз в main().

export module bukvitsa.fb3:document;

import std;
import wxl.core;

import :description;
import :node;

export namespace bukvitsa::fb3 {

/// Картинка книги: байты как они лежали в пакете (jpeg/png/gif/svg).
/// Декодирование — дело того, кто рисует; модель хранит источник.
struct ImagePart {
    // TODO: обсудить!
    wxl::core::u8_text relationshipId;
    // TODO: enum
    wxl::core::u8_text contentType;

    // TODO: - байты надо доставать лениво только для декодирования
    // не надо их хранить
    std::string bytes;
};

/// Сколько в книге чего — снято тем же проходом, что строит дерево.
///
/// Это оценки, по которым вёрстка заранее резервирует свои массивы, а не
/// инварианты. Кодовые точки — не единицы UTF-16 её текста: символ вне BMP
/// даёт две единицы, а знак сноски, который ставит вёрстка, добавляет свои
/// цифры. Абзацы и разделители сосчитаны по виду узла, а выйдет ли из узла
/// блок, вёрстка решает по его месту и детям: заголовок с абзацами внутри сам
/// блоком не станет, а картинка посреди абзаца разрежет его надвое.
struct Measures {
    std::uint32_t codePoints = 0;   ///< то же, что Document::characterCount()
    std::uint32_t paragraphs = 0;   ///< узлы, из которых вёрстка делает текстовый блок
    std::uint32_t images = 0;       ///< `<img>`, и блочные, и в строке
    std::uint32_t separators = 0;   ///< `<br>` и граница бумажной страницы
    std::uint32_t inlineStyles = 0; ///< узлы, которые меняют начертание прогона
    std::uint32_t noteRefs = 0;     ///< ссылки на сноски
};

/// Файл — наверняка не книга FB3: его байты не zip (короче записи конца
/// каталога или не начинаются заголовком части `PK\3\4`) либо пакет прочитан
/// чисто, а связи Book в нём нет вовсе. Отдельный тип, потому что такой файл —
/// чужой, и тому, кто перебирает файлы, о нём бывает нечего сказать. Всё
/// прочее — zip без конца каталога, отказ Packaging API, связь Book не к части — о
/// книге FB3, которая не разобралась, и отказ о ней — иного типа: молчать
/// вправе только о том, что известно наверняка.
class NotFb3Book : public std::runtime_error {
public:
    using std::runtime_error::runtime_error;
};

class Document {
public:
    /// Открывает и разбирает книгу целиком: пакет, метаданные, тело.
    ///
    /// Целиком — потому что тело даже большого романа это единицы мегабайт
    /// XML, а разбор их занимает миллисекунды; ленивость здесь усложнила бы
    /// модель, ничего не выиграв. Картинки — другое дело, они читаются
    /// по требованию (см. image()).
    ///
    /// @throw NotFb3Book, если пакет прочитан чисто, а связи Book в нём нет
    /// (байтов файла до Packaging API здесь никто не смотрит, и «не zip» этот
    /// конструктор не знает); std::runtime_error (и std::system_error от
    /// пакета) — книга повреждена или отказала система.
    explicit Document(const std::filesystem::path& path);

    /// Та же книга из уже прочитанных байтов файла.
    ///
    /// Ради этого конструктора всё и затевалось: файл читает рабочий поток,
    /// а разбирает интерфейсный, потому что разбор берёт память из STA-пула.
    /// Байты переезжают в документ и живут столько же, сколько он: пакет OPC
    /// читает свои части по требованию.
    ///
    /// @throw NotFb3Book, если байты не zip или пакет без связи Book; прочие
    /// отказы — как у конструктора из пути.
    explicit Document(std::string fileBytes);
    ~Document();

    Document(const Document&) = delete;
    Document& operator=(const Document&) = delete;

    /// Описание книги. После takeDescription() его у документа нет, и
    /// спросить его — нарушение, на котором процесс останавливается.
    const Description& description() const;

    /// Отдаёт описание перемещением: книга забирает своё и живёт дальше без
    /// документа, который нужен ей на время открытия, а не на всё чтение.
    /// Второй вызов — нарушение, на котором процесс останавливается.
    Description takeDescription();

    /// Корень тела книги (NodeKind::Body). Его дети — секции верхнего уровня.
    const Node& body() const;

    /// Сноска по идентификатору из NoteRefData::targetId.
    /// Обычно не нужна: ссылки разрешены при загрузке, и у NoteRefData уже
    /// стоят target и номер тела.
    const Node* noteBody(std::string_view id) const;

    /// Тела сносок в порядке документа. Вёрстка разворачивает их отдельно от
    /// потока чтения и адресует номером в этом списке (NoteRefData::body),
    /// а не узлом: номер переживает документ.
    std::span<const Node* const> noteBodies() const;

    /// Полный размер книги в символах — знаменатель прогресса чтения.
    std::uint32_t characterCount() const;

    /// Сколько в книге чего — по этим мерам вёрстка резервирует массивы.
    Measures measures() const;

    /// Картинки в порядке связей тела. Байты читаются при первом обращении:
    /// книга с иллюстрациями не должна тащить их в память ради оглавления.
    std::span<const ImagePart> images() const;
    const ImagePart* image(std::uint32_t index) const;

    /// Отдаёт байты картинки перемещением, прочитав их из пакета, если ещё не
    /// читались; у части остаются связь и тип, байты пустеют (image() прочтёт
    /// их заново). Книга держит их сама: поток WIC смотрит на байты картинки
    /// до конца книги, а документ столько не живёт. Индекс за концом списка —
    /// нарушение, на котором процесс останавливается: пустая строка значила
    /// бы картинку без байтов.
    std::string takeImageBytes(std::uint32_t index);

    /// Узел, внутри которого лежит символ с такой позицией — обратная сторона
    /// Node::charOffset(). Так восстанавливается место чтения после смены
    /// кегля или размера окна.
    const Node* nodeAtCharOffset(std::uint32_t offset) const;

private:
    friend class DocumentBuilder; ///< он собирает дерево прямо в Impl

    /// Общее тело обоих конструкторов: пакет уже открыт, дальше -- разбор.
    void parse();

    struct Impl;                  ///< пакет, разборщики XML, арена узлов
    std::unique_ptr<Impl> impl_;
};

}  // namespace bukvitsa::fb3
